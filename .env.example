# ===== 数据库（PostgreSQL / Prisma Postgres）=====
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ===== 文件存储（Vercel Blob）=====
# 线上必须配置：否则上传的原音无法播放，会浪费 TTS 额度
BLOB_READ_WRITE_TOKEN=
# 未配置时，仅本地开发会回退到 public/uploads/

# ===== AI（OpenAI 兼容协议）=====
AI_API_KEY=
# 可选：强制指定供应商 bailian | openai（默认按 BASE_URL 自动识别）
# AI_PROVIDER=bailian

# 阿里云百炼（推荐本项目）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_TRANSCRIBE_MODEL=qwen3-asr-flash
AI_TTS_MODEL=cosyvoice-v3-flash
# 龙小淳：中英双语，适合带读
AI_TTS_VOICE=longxiaochun_v3

# 省钱默认：关闭云端 TTS（CosyVoice），朗读用「上传原音 + 浏览器语音」
AI_TTS_ENABLED=false
# 跟读录音转写仍可用（按秒计费，通常比 CosyVoice 便宜）
AI_TRANSCRIBE_ENABLED=true

# 总开关（若设置了，会同时覆盖上面两个；一般不要设）
# AI_AUDIO_ENABLED=false

# 需要云端英音带读时再打开（会消耗 CosyVoice 字符额度）：
# AI_TTS_ENABLED=true

# OpenAI 官方示例：
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TRANSCRIBE_MODEL=whisper-1
# AI_TTS_MODEL=tts-1
# AI_TTS_VOICE=nova

# DeepSeek（通常无 ASR/TTS）：
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
# AI_TTS_ENABLED=false
# AI_TRANSCRIBE_ENABLED=false
