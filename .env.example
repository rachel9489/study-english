# ===== 数据库（PostgreSQL / Prisma Postgres）=====
# 本地与 Vercel 都使用同一类连接串，不要再用 SQLite
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ===== 文件存储（Vercel Blob）=====
# 在 Vercel → Storage → Blob 创建后自动注入；本地可用 vercel env pull
BLOB_READ_WRITE_TOKEN=
# 未配置时，本地开发会回退到 public/uploads/

# ===== 真实 AI 接入（OpenAI 兼容协议）=====
# 配置后自动启用：LLM 外教评估 + Whisper 转写 + TTS 朗读
# 不配置则回退本地规则 + 浏览器语音

AI_API_KEY=
# 可选别名：OPENAI_API_KEY=

# OpenAI 官方：
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# DeepSeek 示例：
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# 通义 / 月之暗面等凡兼容 /chat/completions 的均可

AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=whisper-1
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=nova

# 强制开关（默认：有 AI_API_KEY 即开启）
# AI_ENABLED=true

# 供应商若不支持 Whisper/TTS（如部分国产 Chat 接口），设为 false
# AI_AUDIO_ENABLED=false
